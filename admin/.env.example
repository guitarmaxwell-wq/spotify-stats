# Copy to admin/.env (gitignored). Vite inlines VITE_* names at build time.
#
# Only PUBLIC values belong here. The publishable key is designed to ship in
# clients: row-level security and the Edge Functions decide what an admin may do.
# The service-role key must NEVER go in this file or anywhere in admin/.

# Supabase project URL, e.g. https://<ref>.supabase.co (same as EXPO_PUBLIC_SUPABASE_URL)
VITE_SUPABASE_URL=

# Publishable key (same as EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY)
VITE_SUPABASE_PUBLISHABLE_KEY=

# 1 = start with rules-dry-run / rules-evaluate MOCKED (synthetic numbers, no
# grants). Useful before those Edge Functions are deployed. Can also be switched
# in the dashboard header. 0 = call the real functions.
VITE_MOCK_FUNCTIONS=0
