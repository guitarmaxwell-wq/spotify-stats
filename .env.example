# Copy to .env and fill in. .env is gitignored and must stay that way.
# Nothing in this file is a value — these are the names and where you get them.
#
# The Python side (ingest/) reads .env at the repo root.
# The Expo app reads the EXPO_PUBLIC_* names, inlined at build time.


# ---------------------------------------------------------------- Last.fm --
# The scalable path: full listening history from a username, no OAuth.
# Create a key (takes about a minute, no review): https://www.last.fm/api/account/create
# The key identifies the APP, not a user, so it is safe to ship in a client —
# but it still does not belong in git.
LASTFM_API_KEY=
EXPO_PUBLIC_LASTFM_API_KEY=

# Optional default for the CLI, so you can run `python -m ingest.cli lastfm`
# without --user.
LASTFM_USERNAME=


# ---------------------------------------------------------------- Spotify --
# Forward-sync only. Read docs/DATA_SOURCES.md before relying on this:
#   * recently-played returns the last ~50 plays and CANNOT page further back
#   * Development Mode caps the app at 25 hand-allowlisted users
#   * Extended Quota Mode requires a company with 250k+ MAU (since May 2025)
#
# You must create this yourself; there is no shared value that would work:
#   1. https://developer.spotify.com/dashboard -> Create app
#   2. Redirect URI: milk://auth   (must match exactly, including the scheme)
#   3. Which API: Web API
#   4. Copy the Client ID below
#   5. Settings -> User Management: add the email of every Spotify account that
#      will sign in, including your own. Up to 25. Anyone not listed gets an
#      "invalid client" style failure with no useful explanation.
SPOTIFY_CLIENT_ID=
EXPO_PUBLIC_SPOTIFY_CLIENT_ID=

# Must match the dashboard entry and app.json's "scheme".
SPOTIFY_REDIRECT_URI=milk://auth

# NOTE: there is deliberately no SPOTIFY_CLIENT_SECRET here.
# The app uses the PKCE flow so that no secret has to exist on a device. A
# secret shipped inside a mobile binary is a secret you have given away; if you
# find yourself wanting one, the answer is a server, not an env var.
